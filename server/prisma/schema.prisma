generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVestido {
  NOVIA
  MADRINA
  INVITADA
  CIVIL
}

enum EstadoVenta {
  NO_ENTREGADO
  ENTREGADO
}

enum KanbanEstado {
  PENDIENTE
  EN_CONFECCION
  LISTO_ENTREGA
  ENTREGADO
}

enum CategoriaInsumo {
  TELA
  FORRO
  ENCAJE_ADORNO
  CIERRE_BOTONES
  HILOS_AGUJAS_ALFILERES
  OTROS_MATERIALES
}

enum TipoAsignacion {
  DIRECTO
  PRORRATEO
}

enum CategoriaGastoGeneral {
  CAFETERIA_Y_ASEO
  TRANSPORTE_ESTACIONAMIENTO
  MOBILIARIO_Y_EQUIPAMIENTO
  IMPUESTOS_LEGAL_BANCOS
  OTROS
}

enum CotizacionRemitente {
  MARIA
  CARO
}

enum CotizacionEstado {
  PENDIENTE
  ENVIADA
  ACEPTADA
  RECHAZADA
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nombre       String
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ventasCreadas                Venta[]        @relation("VentaCreadoPor")
  ventasActualizadas           Venta[]        @relation("VentaActualizadoPor")
  comprasCreadas               Purchase[]     @relation("PurchaseCreadoPor")
  comprasActualizadas          Purchase[]     @relation("PurchaseActualizadoPor")
  cotizCreadas                 Cotizacion[]   @relation("CotizacionCreadoPor")
  cotizActualizadas            Cotizacion[]   @relation("CotizacionActualizadoPor")
  gastosGeneralesCreados       GastoGeneral[] @relation("GastoGeneralCreadoPor")
  gastosGeneralesActualizados  GastoGeneral[] @relation("GastoGeneralActualizadoPor")
}

model Venta {
  id              String       @id @default(cuid())
  codigo          String       @unique
  nombreClienta   String
  tipo            TipoVestido
  fechaVenta      DateTime
  fechaEvento     DateTime
  fechaEntregaComprometida DateTime?
  fechaEntrega    DateTime?
  precioTotal     Int
  estado          EstadoVenta  @default(NO_ENTREGADO)
  kanbanEstado    KanbanEstado @default(PENDIENTE)
  notas           String?
  notasProduccion String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  creadoPorId      String?
  creadoPor        Usuario?  @relation("VentaCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPorId String?
  actualizadoPor   Usuario?  @relation("VentaActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  cuotas               Cuota[]
  purchaseAssignments  PurchaseAssignment[]
  cotizacion           Cotizacion?

  @@index([tipo])
  @@index([estado])
  @@index([fechaVenta])
  @@index([fechaEvento])
}

model Cuota {
  id              String    @id @default(cuid())
  ventaId         String
  venta           Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  numero          Int
  monto           Int
  fechaProgramada DateTime
  pagada          Boolean   @default(false)
  fechaPago       DateTime?
  montoPagado     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([ventaId, numero])
}

model Purchase {
  id             String          @id @default(cuid())
  fecha          DateTime
  categoria      CategoriaInsumo
  proveedor      String?
  descripcion    String
  montoTotal     Int
  tipoAsignacion TipoAsignacion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creadoPorId      String?
  creadoPor        Usuario? @relation("PurchaseCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("PurchaseActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  asignaciones PurchaseAssignment[]

  comprobanteNombre String?
  comprobanteMime   String?
  comprobanteTamano Int?
  comprobanteDatos  Bytes?

  @@index([categoria])
  @@index([tipoAsignacion])
  @@index([fecha])
}

model PurchaseAssignment {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ventaId       String
  venta         Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  montoAsignado Int
  createdAt     DateTime @default(now())

  @@index([ventaId])
  @@index([purchaseId])
}

// Gastos operacionales que no son insumos de vestidos (café, estacionamiento,
// mobiliario, maniquíes, etc.) — sin asignación a ventas, a diferencia de Purchase.
model GastoGeneral {
  id          String                @id @default(cuid())
  fecha       DateTime
  categoria   CategoriaGastoGeneral
  descripcion String
  montoTotal  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creadoPorId      String?
  creadoPor        Usuario? @relation("GastoGeneralCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("GastoGeneralActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  comprobanteNombre String?
  comprobanteMime   String?
  comprobanteTamano Int?
  comprobanteDatos  Bytes?

  @@index([categoria])
  @@index([fecha])
}

model ConfigTipoVestido {
  id                  String      @id @default(cuid())
  tipo                TipoVestido @unique
  costoEstandar       Int
  consumoTelaEstimado Float
  precioVentaEstandar Int         @default(0)

  updatedAt DateTime @updatedAt
}

// Historial de sueldos: puede haber varias filas por nombre, una por cada
// vez que cambió el monto, para no perder el valor anterior al actualizar.
// Para un mes dado, el vigente es la fila con fechaInicio <= ese mes más
// reciente por nombre (ver config.service.js: seleccionarVigentePorNombre).
model ConfigSueldo {
  id          String   @id @default(cuid())
  nombre      String
  monto       Int
  fechaInicio DateTime

  updatedAt DateTime @updatedAt

  @@unique([nombre, fechaInicio])
  @@index([nombre])
}

// Costos fijos mensuales del EERR / Flujo de Caja (arriendo, servicios, etc.)
// Los sueldos de modistas viven en ConfigSueldo y se suman aparte porque
// también se usan para la mano de obra estimada del módulo de Costeo.
// Mismo historial con fecha que ConfigSueldo (ver comentario arriba).
model ConfigCostoFijo {
  id          String   @id @default(cuid())
  nombre      String
  monto       Int
  fechaInicio DateTime

  updatedAt DateTime @updatedAt

  @@unique([nombre, fechaInicio])
  @@index([nombre])
}

// Fila única con supuestos generales del flujo de caja.
model ConfigFinanciero {
  id           String @id @default("main")
  cajaInicial  Int    @default(9510917)
  sueldoSocias Int    @default(0)

  updatedAt DateTime @updatedAt
}

model PresupuestoVenta {
  id          String      @id @default(cuid())
  tipo        TipoVestido
  mes         DateTime
  cantidad    Int
  montoTotal  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuotas PresupuestoCuota[]

  @@unique([tipo, mes])
  @@index([mes])
}

model PresupuestoCuota {
  id                 String           @id @default(cuid())
  presupuestoVentaId String
  presupuestoVenta   PresupuestoVenta @relation(fields: [presupuestoVentaId], references: [id], onDelete: Cascade)
  numero             Int
  monto              Int
  fecha              DateTime

  @@unique([presupuestoVentaId, numero])
}

model Cotizacion {
  id                   String           @id @default(cuid())
  nombreClienta        String
  emailClienta         String?
  telefonoClienta      String?
  tipo                 TipoVestido
  fechaEventoTentativa DateTime?
  validezDias          Int              @default(15)
  notas                String?
  remitente            CotizacionRemitente?
  estado               CotizacionEstado @default(PENDIENTE)
  fechaEnvio           DateTime?
  fechaRespuesta       DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  creadoPorId      String?
  creadoPor        Usuario? @relation("CotizacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("CotizacionActualizadoPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  items   CotizacionItem[]
  ventaId String?           @unique
  venta   Venta?            @relation(fields: [ventaId], references: [id])

  @@index([estado])
  @@index([tipo])
}

model CotizacionItem {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  orden        Int
  descripcion  String
  cantidad     Int        @default(1)
  monto        Int

  @@index([cotizacionId])
}
