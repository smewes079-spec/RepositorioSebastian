generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoVestido {
  NOVIA
  MADRINA
  INVITADA
  CIVIL
}

enum EstadoVenta {
  NO_ENTREGADO
  ENTREGADO
}

enum KanbanEstado {
  PENDIENTE
  EN_CONFECCION
  LISTO_ENTREGA
  ENTREGADO
}

enum CategoriaInsumo {
  TELA
  FORRO
  ENCAJE_ADORNO
  CIERRE_BOTONES
  HILOS_AGUJAS_ALFILERES
  OTROS_MATERIALES
}

enum TipoAsignacion {
  DIRECTO
  PRORRATEO
}

model Venta {
  id              String       @id @default(cuid())
  codigo          String       @unique
  nombreClienta   String
  tipo            TipoVestido
  fechaVenta      DateTime
  fechaEvento     DateTime
  fechaEntrega    DateTime?
  precioTotal     Int
  estado          EstadoVenta  @default(NO_ENTREGADO)
  kanbanEstado    KanbanEstado @default(PENDIENTE)
  notas           String?
  notasProduccion String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  cuotas               Cuota[]
  purchaseAssignments  PurchaseAssignment[]

  @@index([tipo])
  @@index([estado])
  @@index([fechaVenta])
  @@index([fechaEvento])
}

model Cuota {
  id              String    @id @default(cuid())
  ventaId         String
  venta           Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  numero          Int
  monto           Int
  fechaProgramada DateTime
  pagada          Boolean   @default(false)
  fechaPago       DateTime?
  montoPagado     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([ventaId, numero])
}

model Purchase {
  id             String          @id @default(cuid())
  fecha          DateTime
  categoria      CategoriaInsumo
  descripcion    String
  montoTotal     Int
  tipoAsignacion TipoAsignacion

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asignaciones PurchaseAssignment[]

  @@index([categoria])
  @@index([tipoAsignacion])
  @@index([fecha])
}

model PurchaseAssignment {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ventaId       String
  venta         Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  montoAsignado Int
  createdAt     DateTime @default(now())

  @@index([ventaId])
  @@index([purchaseId])
}

model ConfigTipoVestido {
  id                  String      @id @default(cuid())
  tipo                TipoVestido @unique
  costoEstandar       Int
  consumoTelaEstimado Float
  precioVentaEstandar Int         @default(0)

  updatedAt DateTime @updatedAt
}

model ConfigSueldo {
  id          String   @id @default(cuid())
  nombre      String   @unique
  monto       Int
  fechaInicio DateTime

  updatedAt DateTime @updatedAt
}

// Costos fijos mensuales del EERR / Flujo de Caja (arriendo, servicios, etc.)
// Los sueldos de modistas viven en ConfigSueldo y se suman aparte porque
// también se usan para la mano de obra estimada del módulo de Costeo.
model ConfigCostoFijo {
  id          String   @id @default(cuid())
  nombre      String   @unique
  monto       Int
  fechaInicio DateTime

  updatedAt DateTime @updatedAt
}

// Fila única con supuestos generales del flujo de caja.
model ConfigFinanciero {
  id           String @id @default("main")
  cajaInicial  Int    @default(9510917)
  sueldoSocias Int    @default(0)

  updatedAt DateTime @updatedAt
}

model PresupuestoVenta {
  id          String      @id @default(cuid())
  tipo        TipoVestido
  mes         DateTime
  cantidad    Int
  montoTotal  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuotas PresupuestoCuota[]

  @@unique([tipo, mes])
  @@index([mes])
}

model PresupuestoCuota {
  id                 String           @id @default(cuid())
  presupuestoVentaId String
  presupuestoVenta   PresupuestoVenta @relation(fields: [presupuestoVentaId], references: [id], onDelete: Cascade)
  numero             Int
  monto              Int
  fecha              DateTime

  @@unique([presupuestoVentaId, numero])
}
